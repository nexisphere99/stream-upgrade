



:: eli_bed
<<nobr>>
<<set $locationName to "Eli's Apartment - Bed">>
<<set $right_sidebar_mode to 0>>
<<set $locationImage to "images/locations/eli_bed.jpeg">>
<img src="images/locations/eli_bed.jpeg" alt="Eli's Bed" style="width:100%; height:auto;">
<<if $day == 1 and $day_step == 0>>
<<set $hint = "Wake Up">>
[[Wake Up|day_1_1]]
<<elseif $day == 1 and $day_step == 14>>
<<goto "day_1_15">>
<<elseif $day == 1 and $day_step == 15>>
[[Wake Up|day_2_1]]
<<elseif $day ==2 and $day_step == 31>>
<<goto "day_2_32_kira">>
<<elseif $day == 2 and $day_step == 32>>
<<set $hint = "Wake up">>
[[Wake Up|day_3_1_kira]]
<<elseif $day == 2 and $day_step == 34>>
<<set $hint = "Wake up">>
[[Wake Up|day_3_1_other]]
<<elseif $day == 3 and $day_step == 43>>
[[Sleep|day_3_44_kira]]
<<elseif $day == 3 and $day_step == 44>>
[[Wake Up|day_4_1_kira]]
<<elseif $day == 3 and $day_step == 23>>
[[Wait|day_3_24_kira]]
<<elseif $day == 3 and $day_step == 28>>
[[Wake Up|day_4_1_other]]
<<else>>
    <<if $route == "kira">>
        <<if $day == 4 and $day_step == 26>>
        [[Wake Up|day_5_1_kira]]
        <<elseif $day == 5 and $day_step == 13>>
        [[Prepare for Kira|day_5_14_kira]]
        <<elseif $day == 5 and $day_step == 24>>
        [[Try to Sleep|day_5_25_kira]]
        <<elseif $day == 5 and $day_step == 25>>
        [[Wakue Up|day_6_1_kira]]
        <</if>>
    <<elseif $route == "other">>
        <<if $day == 4 and $day_step == 25>>
        [[Wake Up|day_5_1_other]]
        <<elseif $day == 5 and $day_step == 12>>
        [[Spend Time|day_5_13_other]]
        <<elseif $day == 5 and $day_step == 23>>
        [[Try to Sleep|day_5_24_other]]
        <</if>>
    <</if>>
<</if>>
[[Masturbate|mastruebate_bed]] | [[Rest|bed_rest]] | [[Sleep|bed_sleep]] | [[← Floor Plan|apartment_map]]
<</nobr>>



