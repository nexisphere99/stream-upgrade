<</nobr>>
<<script>>
(function() {
  var LABELS = {
    'eli_bed':      "Bed Area",
    'eli_desk':     "Streaming Desk",
    'eli_kitchen':  "Kitchen",
    'eli_bathroom': "Bathroom",
    'eli_closet':   "Closet",
    'eli_balcony':  "Balcony"
  };
  var OPEN = {
    'eli_bed':      true,
    'eli_desk':     true,
    'eli_kitchen':  true,
    'eli_bathroom': true,
    'eli_closet':   true
    // eli_balcony is NOT in OPEN = blocked
  };

  var svg      = document.getElementById('apt-svg');
  var tooltip  = document.getElementById('apt-tooltip');
  var flash    = document.getElementById('apt-blocked-flash');
  var flashTimer = null;

  if (!svg) return;

  // Mark blocked mobile legend items
  document.querySelectorAll('.aml-item').forEach(function(el) {
    var match = (el.getAttribute('onclick') || '').match(/play\('([^']+)'\)/);
    if (match && !OPEN[match[1]]) {
      el.removeAttribute('onclick');
      el.classList.add('aml-item-blocked');
      el.addEventListener('click', function() {
        if (flash) {
          flash.classList.add('visible');
          if (flashTimer) clearTimeout(flashTimer);
          flashTimer = setTimeout(function() { flash.classList.remove('visible'); }, 1800);
        }
      });
    }
  });

  // Tag groups, handle blocked state
  var groups = svg.querySelectorAll('.aml');
  groups.forEach(function(g) {
    var loc = g.getAttribute('data-loc');
    if (!loc) return;
    if (!OPEN[loc]) {
      g.classList.add('aml-blocked');
      g.removeAttribute('onclick');
      g.addEventListener('click', function(e) {
        e.stopPropagation();
        if (flash) {
          flash.classList.add('visible');
          if (flashTimer) clearTimeout(flashTimer);
          flashTimer = setTimeout(function() {
            flash.classList.remove('visible');
          }, 1800);
        }
      });
    }
  });

  // Tooltip delegation
  svg.addEventListener('mouseover', function(e) {
    var g = e.target.closest('.aml');
    if (!g) return;
    var loc = g.getAttribute('data-loc');
    if (!loc || !LABELS[loc]) return;
    var label = LABELS[loc];
    if (!OPEN[loc]) label = label + ' [LOCKED]';
    tooltip.textContent = label;
    tooltip.classList.add('visible');
  });

  svg.addEventListener('mouseout', function(e) {
    var g = e.target.closest('.aml');
    if (!g) return;
    setTimeout(function() {
      tooltip.classList.remove('visible');
    }, 150);
  });
})();
<</script>>

<div class="apt-mobile-legend">
  <div class="aml-title">◉ ROOMS</div>
  <div class="aml-grid">
    <span class="aml-item" style="--c:#e84393" onclick="SugarCube.Engine.play('eli_bed')">🛏 Bed Area</span>
    <span class="aml-item" style="--c:#e84393" onclick="SugarCube.Engine.play('eli_desk')">💻 Streaming Desk</span>
    <span class="aml-item" style="--c:#e84393" onclick="SugarCube.Engine.play('eli_kitchen')">🍳 Kitchen</span>
    <span class="aml-item" style="--c:#2dd4bf" onclick="SugarCube.Engine.play('eli_bathroom')">🚿 Bathroom</span>
    <span class="aml-item" style="--c:#a855f7" onclick="SugarCube.Engine.play('eli_closet')">👗 Closet</span>
    <span class="aml-item" style="--c:#3a3a4a" onclick="SugarCube.Engine.play('eli_balcony')">🔒 Balcony</span>
  </div>
</div>










