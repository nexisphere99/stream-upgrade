:: apartment_map
<<nobr>>
<style>
.apt-map-outer {
  max-width: 100%;
  overflow-x: auto;
  background: #0b0b14;
  border: 1.5px solid #e84393;
  border-radius: 12px;
  padding: 8px;
  box-sizing: border-box;
  position: relative;
}
.apt-map-header {
  font-family: monospace;
  text-align: center;
  color: #a0305a;
  letter-spacing: 0.18em;
  font-size: 0.85em;
  padding: 6px 0 10px 0;
  text-transform: uppercase;
}
.apt-map {
  width: 100%;
  height: auto;
  display: block;
}
.aml {
  cursor: pointer;
}
.aml .amb {
  transition: opacity 0.15s, stroke 0.15s, stroke-width 0.15s;
  stroke: transparent;
  stroke-width: 0;
}
.aml:hover .amb {
  stroke: rgba(232, 67, 147, 0.55);
  stroke-width: 2.5;
  opacity: 0.88;
}
.aml-blocked {
  cursor: not-allowed !important;
}
.aml-blocked .amb {
  filter: brightness(0.25) saturate(0.1) !important;
  opacity: 0.5;
}
.aml-blocked:hover .amb {
  filter: brightness(0.3) saturate(0.15) !important;
  opacity: 0.55;
}
#apt-tooltip {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 15, 0.94);
  color: #fd79a8;
  font-family: monospace;
  font-size: 0.72rem;
  font-weight: bold;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 999px;
  border: 1px solid rgba(232, 67, 147, 0.35);
  box-shadow: 0 0 14px rgba(232, 67, 147, 0.2);
  pointer-events: none;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.15s ease;
  z-index: 9000;
}
#apt-tooltip.visible { opacity: 1; }
#apt-blocked-flash {
  position: fixed;
  top: 50%;
  left: 50%;
  max-width: min(300px, 88vw);
  box-sizing: border-box;
  transform: translate(-50%, -50%) scale(0.9);
  background: rgba(10, 10, 15, 0.96);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #fca5a5;
  font-family: monospace;
  font-size: 0.78rem;
  font-weight: bold;
  letter-spacing: 0.08em;
  text-align: center;
  word-break: break-word;
  padding: 12px 20px;
  border-radius: 10px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 9999;
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
}
#apt-blocked-flash.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* Mobile room list - hidden on desktop */
.apt-mobile-legend { display: none; }

@media (max-width: 900px) {
  .apt-mobile-legend {
    display: block;
    margin-top: 10px;
  }
  .aml-title {
    font-family: monospace;
    font-size: 0.68rem;
    color: #5d5875;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .aml-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .aml-item {
    display: block;
    padding: 7px 8px;
    border-radius: 7px;
    border: 1px solid var(--c);
    color: var(--c);
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.03em;
    cursor: pointer;
    text-align: center;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
    opacity: 0.75;
  }
  .aml-item:active { opacity: 1; }
  .aml-item-blocked {
    --c: #3a3a4a !important;
    cursor: not-allowed !important;
    opacity: 0.3;
  }
}
</style>

<div class="apt-map-outer" id="apt-map-container">
  <div class="apt-map-header">◉ ELI'S APARTMENT - FLOOR PLAN</div>
  <svg class="apt-map" viewBox="0 0 660 520" xmlns="http://www.w3.org/2000/svg" id="apt-svg">
    <defs>
      <!-- Pink glow filter for desk area -->
      <filter id="agp" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#e84393" flood-opacity="0.45" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Teal glow filter for bathroom -->
      <filter id="agt" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#2dd4bf" flood-opacity="0.45" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Subtle pink glow for monitor screens -->
      <filter id="agp-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feFlood flood-color="#e84393" flood-opacity="0.6" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- ============================================================ -->
    <!-- APARTMENT BACKGROUND -->
    <!-- ============================================================ -->
    <rect x="0" y="0" width="660" height="520" fill="#0b0b14"/>

    <!-- ============================================================ -->
    <!-- OUTER WALLS -->
    <!-- ============================================================ -->
    <!-- Top wall -->
    <rect x="0" y="0" width="660" height="4" fill="#1a1a2e"/>
    <!-- Left wall -->
    <rect x="0" y="0" width="4" height="520" fill="#1a1a2e"/>
    <!-- Right wall -->
    <rect x="656" y="0" width="4" height="520" fill="#1a1a2e"/>
    <!-- Bottom wall left segment (before door gap x=190) -->
    <rect x="0" y="514" width="190" height="6" fill="#1a1a2e"/>
    <!-- Bottom wall right segment (after door gap x=400) -->
    <rect x="400" y="514" width="260" height="6" fill="#1a1a2e"/>

    <!-- Door arc at bottom (entrance) -->
    <path d="M 190 514 Q 295 460 400 514" fill="none" stroke="#e84393" stroke-width="1" stroke-dasharray="5,3" opacity="0.5"/>
    <!-- Door frame lines -->
    <line x1="190" y1="510" x2="190" y2="520" stroke="#e84393" stroke-width="1.5" opacity="0.6"/>
    <line x1="400" y1="510" x2="400" y2="520" stroke="#e84393" stroke-width="1.5" opacity="0.6"/>
    <!-- EXIT label -->
    <text x="295" y="519" font-family="monospace" font-size="7" fill="#e84393" text-anchor="middle" letter-spacing="2" opacity="0.7">EXIT</text>

    <!-- ============================================================ -->
    <!-- HORIZONTAL WALL: y=58..66 (top room divider / balcony border) -->
    <!-- ============================================================ -->
    <!-- Left segment: x=0..270 -->
    <rect x="0" y="58" width="270" height="8" fill="#1a1a2e"/>
    <!-- Right segment: x=390..660 -->
    <rect x="390" y="58" width="270" height="8" fill="#1a1a2e"/>
    <!-- Balcony door frame lines -->
    <line x1="270" y1="55" x2="270" y2="69" stroke="#e84393" stroke-width="1.5" opacity="0.5"/>
    <line x1="390" y1="55" x2="390" y2="69" stroke="#e84393" stroke-width="1.5" opacity="0.5"/>
    <!-- Balcony door arc -->
    <path d="M 270 66 Q 330 90 390 66" fill="none" stroke="#555577" stroke-width="1" stroke-dasharray="4,3" opacity="0.4"/>

    <!-- ============================================================ -->
    <!-- HORIZONTAL WALL: y=188..196 (top rooms / main room divider) -->
    <!-- ============================================================ -->
    <!-- Left segment: x=0..80 (before kitchen door) -->
    <rect x="0" y="188" width="80" height="8" fill="#1a1a2e"/>
    <!-- Middle segment: x=150..380 (between kitchen door and bathroom door) -->
    <rect x="150" y="188" width="230" height="8" fill="#1a1a2e"/>
    <!-- Right segment: x=450..660 (after bathroom door) -->
    <rect x="450" y="188" width="210" height="8" fill="#1a1a2e"/>
    <!-- Kitchen door frame -->
    <line x1="80" y1="185" x2="80" y2="199" stroke="#c0a060" stroke-width="1.5" opacity="0.6"/>
    <line x1="150" y1="185" x2="150" y2="199" stroke="#c0a060" stroke-width="1.5" opacity="0.6"/>
    <!-- Bathroom door frame -->
    <line x1="380" y1="185" x2="380" y2="199" stroke="#2dd4bf" stroke-width="1.5" opacity="0.5"/>
    <line x1="450" y1="185" x2="450" y2="199" stroke="#2dd4bf" stroke-width="1.5" opacity="0.5"/>
    <!-- Door arcs -->
    <path d="M 80 196 Q 115 175 150 196" fill="none" stroke="#c0a060" stroke-width="1" stroke-dasharray="4,3" opacity="0.4"/>
    <path d="M 380 196 Q 415 175 450 196" fill="none" stroke="#2dd4bf" stroke-width="1" stroke-dasharray="4,3" opacity="0.4"/>

    <!-- ============================================================ -->
    <!-- VERTICAL WALL: x=236..242 (kitchen / closet) -->
    <!-- ============================================================ -->
    <rect x="236" y="66" width="6" height="122" fill="#1a1a2e"/>

    <!-- ============================================================ -->
    <!-- VERTICAL WALL: x=358..364 (closet / bathroom) -->
    <!-- ============================================================ -->
    <rect x="358" y="66" width="6" height="122" fill="#1a1a2e"/>

    <!-- ============================================================ -->
    <!-- VERTICAL WALL: x=336..344 (bed area / desk area) -->
    <!-- ============================================================ -->
    <rect x="336" y="196" width="8" height="322" fill="#1a1a2e"/>

    <!-- ============================================================ -->
    <!-- BALCONY (y=0..58, full width) - BLOCKED -->
    <!-- ============================================================ -->
    <g class="aml" data-loc="eli_balcony">
      <rect class="amb" x="4" y="4" width="652" height="54" fill="#090f09" rx="2"/>
      <!-- Balcony railing lines -->
      <line x1="12" y1="12" x2="648" y2="12" stroke="#1a2a1a" stroke-width="1.5"/>
      <line x1="12" y1="50" x2="648" y2="50" stroke="#1a2a1a" stroke-width="1.5"/>
      <!-- Vertical railing bars -->
      <line x1="40" y1="12" x2="40" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="80" y1="12" x2="80" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="120" y1="12" x2="120" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="160" y1="12" x2="160" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="200" y1="12" x2="200" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="240" y1="12" x2="240" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="420" y1="12" x2="420" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="460" y1="12" x2="460" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="500" y1="12" x2="500" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="540" y1="12" x2="540" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="580" y1="12" x2="580" y2="50" stroke="#162016" stroke-width="1"/>
      <line x1="620" y1="12" x2="620" y2="50" stroke="#162016" stroke-width="1"/>
      <!-- Dead plant on balcony -->
      <ellipse cx="60" cy="38" rx="10" ry="6" fill="#1a1a0a" stroke="#2a2a10" stroke-width="1"/>
      <line x1="60" y1="32" x2="58" y2="20" stroke="#1a1a0a" stroke-width="1.5"/>
      <line x1="60" y1="28" x2="55" y2="24" stroke="#1a1a0a" stroke-width="1"/>
      <!-- Locked padlock icon -->
      <rect x="316" y="20" width="18" height="14" fill="#1a1a2e" stroke="#3a3a5a" stroke-width="1" rx="2"/>
      <path d="M 319 20 Q 319 14 325 14 Q 331 14 331 20" fill="none" stroke="#3a3a5a" stroke-width="1.5"/>
      <circle cx="325" cy="27" r="2.5" fill="#3a3a5a"/>
      <!-- BALCONY label -->
      <text x="330" y="44" font-family="monospace" font-size="8" fill="#2a3a2a" text-anchor="middle" letter-spacing="2">BALCONY</text>
      <text x="330" y="54" font-family="monospace" font-size="6" fill="#2a3a2a" text-anchor="middle" letter-spacing="1" opacity="0.6">- LOCKED -</text>
    </g>

    <!-- ============================================================ -->
    <!-- KITCHEN (x=2..236, y=66..188) -->
    <!-- ============================================================ -->
    <g class="aml" data-loc="eli_kitchen" onclick="SugarCube.Engine.play('eli_kitchen')">
      <rect class="amb" x="4" y="66" width="232" height="122" fill="#0e1008"/>
      <!-- Counter strip along top wall -->
      <rect x="10" y="72" width="218" height="22" fill="#1a1008" stroke="#5a3a18" stroke-width="1" rx="1"/>
      <!-- Mini-fridge on counter -->
      <rect x="14" y="74" width="24" height="18" fill="#161210" stroke="#3a2a18" stroke-width="1" rx="1"/>
      <rect x="16" y="76" width="20" height="14" fill="#121010" stroke="#2a1a10" stroke-width="0.5" rx="1"/>
      <line x1="26" y1="76" x2="26" y2="90" stroke="#2a1a10" stroke-width="0.5"/>
      <!-- Microwave -->
      <rect x="46" y="75" width="40" height="16" fill="#161210" stroke="#3a2a18" stroke-width="1" rx="1"/>
      <rect x="48" y="77" width="28" height="12" fill="#0e0e0e" stroke="#2a2a18" stroke-width="0.5" rx="0.5"/>
      <rect x="78" y="77" width="6" height="12" fill="#1a1410" stroke="#2a2010" stroke-width="0.5" rx="0.5"/>
      <!-- Hot plate -->
      <rect x="96" y="76" width="28" height="14" fill="#1a1010" stroke="#3a2010" stroke-width="1" rx="1"/>
      <circle cx="104" cy="83" r="4" fill="none" stroke="#2a1808" stroke-width="1.5"/>
      <circle cx="116" cy="83" r="4" fill="none" stroke="#2a1808" stroke-width="1.5"/>
      <!-- Sink -->
      <rect x="152" y="75" width="32" height="14" fill="#0e1414" stroke="#2a3a3a" stroke-width="1" rx="1"/>
      <ellipse cx="168" cy="82" rx="11" ry="5" fill="#0a1010" stroke="#1a2a2a" stroke-width="1"/>
      <circle cx="168" cy="82" r="2" fill="#0e1414" stroke="#1a3030" stroke-width="0.5"/>
      <!-- Ramen cups below counter -->
      <rect x="30" y="104" width="18" height="20" fill="#1a1208" stroke="#3a2a10" stroke-width="1" rx="2"/>
      <rect x="52" y="104" width="18" height="20" fill="#1a1208" stroke="#3a2a10" stroke-width="1" rx="2"/>
      <rect x="74" y="104" width="18" height="20" fill="#1a1208" stroke="#3a2a10" stroke-width="1" rx="2"/>
      <!-- Ramen cup labels (tiny lines) -->
      <line x1="33" y1="112" x2="45" y2="112" stroke="#2a1a08" stroke-width="1"/>
      <line x1="55" y1="112" x2="67" y2="112" stroke="#2a1a08" stroke-width="1"/>
      <line x1="77" y1="112" x2="89" y2="112" stroke="#2a1a08" stroke-width="1"/>
      <!-- Monster cans (green) -->
      <rect x="116" y="104" width="12" height="22" fill="#0a1a08" stroke="#1a4a0a" stroke-width="1" rx="1"/>
      <rect x="132" y="104" width="12" height="22" fill="#0a1a08" stroke="#1a4a0a" stroke-width="1" rx="1"/>
      <!-- Monster can logo lines -->
      <path d="M 118 112 L 122 108 L 124 112 L 128 108" fill="none" stroke="#1a5a0a" stroke-width="1"/>
      <path d="M 134 112 L 138 108 L 140 112 L 144 108" fill="none" stroke="#1a5a0a" stroke-width="1"/>
      <!-- Small kitchen table -->
      <rect x="30" y="140" width="80" height="40" fill="#160e08" stroke="#2a1a10" stroke-width="1" rx="2"/>
      <!-- Bowl on table -->
      <ellipse cx="60" cy="157" rx="12" ry="7" fill="#0e0e0a" stroke="#2a2010" stroke-width="1"/>
      <!-- Empty pizza box in corner -->
      <rect x="150" y="138" width="68" height="44" fill="#1a1008" stroke="#2a1a08" stroke-width="1" rx="1"/>
      <line x1="184" y1="138" x2="184" y2="182" stroke="#2a1a08" stroke-width="0.5"/>
      <line x1="150" y1="160" x2="218" y2="160" stroke="#2a1a08" stroke-width="0.5"/>
      <!-- KITCHEN label -->
      <text x="119" y="183" font-family="monospace" font-size="8" fill="#6a4020" text-anchor="middle" letter-spacing="2">KITCHEN</text>
    </g>

    <!-- ============================================================ -->
    <!-- CLOSET (x=242..358, y=66..188) -->
    <!-- ============================================================ -->
    <g class="aml" data-loc="eli_closet" onclick="SugarCube.Engine.play('eli_closet')">
      <rect class="amb" x="242" y="66" width="116" height="122" fill="#0c0c14"/>
      <!-- Hanging rod -->
      <line x1="248" y1="90" x2="356" y2="90" stroke="#2a2a3a" stroke-width="2.5"/>
      <!-- Hanging clothes (4 items) - top-down view of hangers + clothing shapes -->
      <!-- Hanger 1 -->
      <line x1="262" y1="90" x2="262" y2="94" stroke="#3a3a5a" stroke-width="1"/>
      <path d="M 252 94 Q 262 91 272 94 L 270 130 Q 262 133 254 130 Z" fill="#1a1830" stroke="#2a2840" stroke-width="0.5" opacity="0.9"/>
      <!-- Hanger 2 -->
      <line x1="285" y1="90" x2="285" y2="94" stroke="#3a3a5a" stroke-width="1"/>
      <path d="M 275 94 Q 285 91 295 94 L 293 125 Q 285 128 277 125 Z" fill="#201a14" stroke="#302810" stroke-width="0.5" opacity="0.9"/>
      <!-- Hanger 3 -->
