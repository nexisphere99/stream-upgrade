      <path d="M 298 94 Q 308 91 318 94 L 316 128 Q 308 131 300 128 Z" fill="#14201a" stroke="#1a2a20" stroke-width="0.5" opacity="0.9"/>
      <!-- Hanger 4 -->
      <line x1="331" y1="90" x2="331" y2="94" stroke="#3a3a5a" stroke-width="1"/>
      <path d="M 321 94 Q 331 91 341 94 L 339 122 Q 331 125 323 122 Z" fill="#201418" stroke="#2a1a20" stroke-width="0.5" opacity="0.9"/>
      <!-- Clothes pile on floor -->
      <ellipse cx="270" cy="158" rx="18" ry="9" fill="#18161e" stroke="#2a2430" stroke-width="1" opacity="0.9"/>
      <ellipse cx="318" cy="162" rx="14" ry="7" fill="#1a1410" stroke="#2a1e14" stroke-width="1" opacity="0.8"/>
      <ellipse cx="295" cy="170" rx="20" ry="8" fill="#16141c" stroke="#221e28" stroke-width="1" opacity="0.85"/>
      <!-- Shoe box on floor -->
      <rect x="248" y="142" width="30" height="20" fill="#161010" stroke="#2a1818" stroke-width="1" rx="1"/>
      <!-- CLOSET label -->
      <text x="300" y="183" font-family="monospace" font-size="8" fill="#3a3a56" text-anchor="middle" letter-spacing="2">CLOSET</text>
    </g>

    <!-- ============================================================ -->
    <!-- BATHROOM (x=364..658, y=66..188) - teal filter -->
    <!-- ============================================================ -->
    <g class="aml" data-loc="eli_bathroom" onclick="SugarCube.Engine.play('eli_bathroom')" filter="url(#agt)">
      <rect class="amb" x="364" y="66" width="292" height="122" fill="#0a1416"/>
      <!-- Shower stall (top-right corner) -->
      <rect x="530" y="70" width="122" height="112" fill="#0a1a1e" stroke="#2dd4bf" stroke-width="1" rx="2" opacity="0.9"/>
      <!-- Shower floor drain -->
      <circle cx="591" cy="126" r="8" fill="#091214" stroke="#1a3030" stroke-width="1"/>
      <circle cx="591" cy="126" r="4" fill="none" stroke="#1a3030" stroke-width="1"/>
      <!-- Showerhead (top-down: small circle on wall) -->
      <circle cx="645" cy="78" r="7" fill="#1a2a2a" stroke="#2dd4bf" stroke-width="1.5"/>
      <circle cx="645" cy="78" r="4" fill="#0e1a1a" stroke="#1a3030" stroke-width="0.5"/>
      <!-- Water stream lines (dashed) -->
      <line x1="638" y1="86" x2="580" y2="120" stroke="#1a3838" stroke-width="1" stroke-dasharray="3,3" opacity="0.6"/>
      <line x1="642" y1="88" x2="584" y2="122" stroke="#1a3838" stroke-width="1" stroke-dasharray="3,3" opacity="0.4"/>
      <!-- Shower shelf -->
      <rect x="534" y="72" width="36" height="14" fill="#0e1a1e" stroke="#1a3030" stroke-width="0.5" rx="1"/>
      <!-- Shampoo bottles on shelf -->
      <rect x="537" y="74" width="6" height="10" fill="#0a2020" stroke="#1a4040" stroke-width="0.5" rx="1"/>
      <rect x="546" y="74" width="6" height="10" fill="#0a1a20" stroke="#1a3a4a" stroke-width="0.5" rx="1"/>
      <rect x="555" y="74" width="6" height="10" fill="#1a0a20" stroke="#3a1a40" stroke-width="0.5" rx="1"/>
      <!-- Toilet (left side) -->
      <rect x="372" y="74" width="38" height="52" fill="#0e1a1e" stroke="#2dd4bf" stroke-width="1" rx="3"/>
      <!-- Toilet tank -->
      <rect x="374" y="76" width="34" height="18" fill="#0a1414" stroke="#1a2a2a" stroke-width="0.5" rx="2"/>
      <!-- Toilet seat oval -->
      <ellipse cx="391" cy="110" rx="15" ry="12" fill="#0a1010" stroke="#2dd4bf" stroke-width="1" opacity="0.8"/>
      <ellipse cx="391" cy="110" rx="10" ry="8" fill="#091010" stroke="#1a2828" stroke-width="0.5"/>
      <!-- Sink (center) -->
      <rect x="424" y="76" width="40" height="38" fill="#0e1a1e" stroke="#2dd4bf" stroke-width="1" rx="3"/>
      <!-- Sink basin ellipse -->
      <ellipse cx="444" cy="95" rx="14" ry="12" fill="#091212" stroke="#1a3030" stroke-width="1"/>
      <!-- Drain -->
      <circle cx="444" cy="98" r="3" fill="#060e0e" stroke="#1a2828" stroke-width="1"/>
      <!-- Faucet tap (small circle/rect) -->
      <rect x="440" y="77" width="8" height="6" fill="#1a2a2a" stroke="#2dd4bf" stroke-width="0.5" rx="1"/>
      <!-- Mirror on wall above sink (top-down: thin rect against top wall) -->
      <rect x="420" y="68" width="48" height="6" fill="#121a1e" stroke="#1a3a3a" stroke-width="0.5" rx="1"/>
      <!-- Towel bar on wall -->
