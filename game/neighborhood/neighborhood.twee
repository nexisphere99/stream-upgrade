    <line x1="652" y1="290" x2="792" y2="290" stroke="#1a2e1a" stroke-width="4"/>
    <!-- Fountain circle (center of park rows 2-3) -->
    <circle cx="722" cy="240" r="16" fill="#0d1f0d" stroke="#2a5a2a" stroke-width="2"/>
    <circle cx="722" cy="240" r="9" fill="#0d2020" stroke="#1e4a4a" stroke-width="1.5"/>
    <circle cx="722" cy="240" r="3" fill="#1e3a3a"/>
    <!-- Benches -->
    <rect x="700" y="264" width="10" height="4" fill="#1a3020" stroke="#2a4a2a" stroke-width="1"/>
    <rect x="732" y="264" width="10" height="4" fill="#1a3020" stroke="#2a4a2a" stroke-width="1"/>
    <rect x="700" y="216" width="10" height="4" fill="#1a3020" stroke="#2a4a2a" stroke-width="1"/>
    <rect x="732" y="216" width="10" height="4" fill="#1a3020" stroke="#2a4a2a" stroke-width="1"/>
    <!-- Park labels -->
    <text x="722" y="178" font-family="monospace" font-size="9" fill="#2a6a2a" text-anchor="middle" letter-spacing="1">EASTSIDE</text>
    <text x="722" y="191" font-family="monospace" font-size="9" fill="#2a6a2a" text-anchor="middle" letter-spacing="1">PARK</text>
    <!-- Park clickable area -->
    <g class="ml ml-hi" onclick="SugarCube.Engine.play('park')">
      <rect class="mb" x="652" y="122" width="140" height="338" fill="transparent" stroke="none"/>
    </g>

    <!-- ============================================================ -->
    <!-- ROW 1 BUILDINGS (y=8 to y=100) -->
    <!-- ============================================================ -->

    <!-- Col A: ELI'S APARTMENT -->
    <g class="ml ml-hi" onclick="SugarCube.Engine.play('apartment_map')">
      <rect class="mb" x="8" y="8" width="122" height="100" fill="#1e0d1a" stroke="#e84393" stroke-width="1.5" rx="3" filter="url(#gp)"/>
      <!-- Windows -->
      <rect x="18" y="20" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="38" y="20" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="58" y="20" width="14" height="12" fill="#5a1a3a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="78" y="20" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="98" y="20" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="18" y="40" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="38" y="40" width="14" height="12" fill="#5a1a3a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="58" y="40" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="78" y="40" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="98" y="40" width="14" height="12" fill="#5a1a3a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="18" y="60" width="14" height="12" fill="#5a1a3a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="38" y="60" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="58" y="60" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="78" y="60" width="14" height="12" fill="#5a1a3a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <rect x="98" y="60" width="14" height="12" fill="#3a1a2a" stroke="#e84393" stroke-width="0.5" rx="1"/>
      <text x="69" y="86" font-family="monospace" font-size="7.5" fill="#e84393" text-anchor="middle" font-weight="bold">ELI'S APARTMENT</text>
      <text x="69" y="97" font-family="monospace" font-size="6.5" fill="#e84393" text-anchor="middle">★ HOME</text>
    </g>

    <!-- Col B: COFFEE SHOP -->
    <g class="ml ml-hi" onclick="SugarCube.Engine.play('coffee_shop')">
