      <rect x="218" y="36" width="12" height="10" fill="#3a2010" stroke="#a0522d" stroke-width="0.5" rx="1"/>
      <text x="207" y="62" font-family="monospace" font-size="14" fill="#a0522d" text-anchor="middle">☕</text>
      <text x="207" y="80" font-family="monospace" font-size="7.5" fill="#a0522d" text-anchor="middle" font-weight="bold">COFFEE SHOP</text>
      <text x="207" y="92" font-family="monospace" font-size="6.5" fill="#7a3a1a" text-anchor="middle">OPEN 24H</text>
    </g>

    <!-- Col C: KIRA'S APARTMENT -->
    <g class="ml ml-hi" onclick="SugarCube.Engine.play('kira_apartment')">
      <rect class="mb" x="284" y="8" width="106" height="100" fill="#130e1e" stroke="#a855f7" stroke-width="1.5" rx="3" filter="url(#gb)"/>
      <!-- Windows -->
      <rect x="294" y="20" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="312" y="20" width="12" height="10" fill="#2e1848" stroke="#a855f7" stroke-width="0.5" rx="1"/>
