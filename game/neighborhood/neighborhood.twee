      <rect x="294" y="38" width="12" height="10" fill="#2e1848" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="312" y="38" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="330" y="38" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="348" y="38" width="12" height="10" fill="#2e1848" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="366" y="38" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="294" y="56" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="312" y="56" width="12" height="10" fill="#2e1848" stroke="#a855f7" stroke-width="0.5" rx="1"/>
      <rect x="330" y="56" width="12" height="10" fill="#1e1030" stroke="#a855f7" stroke-width="0.5" rx="1"/>
