    <!-- Key Location -->
    <rect x="18" y="511" width="10" height="10" fill="#1e0d1a" stroke="#e84393" stroke-width="1" rx="1"/>
    <text x="34" y="520" font-family="monospace" font-size="7.5" fill="#8a8aaa">Key Location</text>
    <!-- Visitable -->
    <rect x="18" y="527" width="10" height="10" fill="#0e1320" stroke="#60a5fa" stroke-width="1" rx="1"/>
    <text x="34" y="536" font-family="monospace" font-size="7.5" fill="#8a8aaa">Visitable</text>
    <!-- Park -->
    <rect x="18" y="543" width="10" height="10" fill="#1a3a1a" stroke="#2a6a2a" stroke-width="1" rx="1"/>
    <text x="34" y="552" font-family="monospace" font-size="7.5" fill="#8a8aaa">Park</text>
    <!-- River -->
    <rect x="18" y="559" width="10" height="10" fill="#09131e" stroke="#1e4a6a" stroke-width="1" rx="1"/>
    <text x="34" y="568" font-family="monospace" font-size="7.5" fill="#8a8aaa">River</text>

    <!-- ============================================================ -->
    <!-- COMPASS ROSE (bottom-right of SVG) -->
    <!-- ============================================================ -->
    <g transform="translate(750, 530)">
      <!-- Compass background -->
      <circle cx="0" cy="0" r="26" fill="#0e0e18" stroke="#2a2a40" stroke-width="1"/>
      <!-- North arrow (pink) -->
      <polygon points="0,-20 4,-8 0,-12 -4,-8" fill="#e84393"/>
      <!-- South arrow (dim) -->
      <polygon points="0,20 4,8 0,12 -4,8" fill="#2a2a40"/>
      <!-- East arrow (dim) -->
      <polygon points="20,0 8,-4 12,0 8,4" fill="#2a2a40"/>
      <!-- West arrow (dim) -->
      <polygon points="-20,0 -8,-4 -12,0 -8,4" fill="#2a2a40"/>
      <!-- Center dot -->
      <circle cx="0" cy="0" r="3" fill="#1a1a2e" stroke="#3a3a5a" stroke-width="1"/>
      <!-- Cardinal labels -->
      <text x="0" y="-24" font-family="monospace" font-size="8" fill="#e84393" text-anchor="middle" font-weight="bold">N</text>
      <text x="0" y="34" font-family="monospace" font-size="8" fill="#4a4a70" text-anchor="middle">S</text>
      <text x="30" y="4" font-family="monospace" font-size="8" fill="#4a4a70" text-anchor="middle">E</text>
      <text x="-30" y="4" font-family="monospace" font-size="8" fill="#4a4a70" text-anchor="middle">W</text>
    </g>

  </svg>
  <div id="map-tooltip"></div>
</div>
<div id="map-blocked-flash">🔒 ACCESS BLOCKED - Coming Soon</div>

<<script>>
setTimeout(function () {
    var LABELS = {
        'apartment_map':     "Eli's Apartment",
        'kira_apartment':    "Kira's Apartment",
        'marc_apartment':    "Marc's Apartment",
        'coffee_shop':       "Coffee Shop",
        'regenaform':        "RegenaForm Clinic",
        'mall':              "East Side Mall",
        'restaurant':        "Restaurant",
        'salon':             "Salon",
        'gym':               "Gym",
        'laundromat':        "Laundromat",
        'pawn_shop':         "Pawn Shop",
        'dark_alley':        "Dark Alley",
        'sex_toy_shop':      "Adult Store",
        'liquor_store':      "Liquor Store",
        'pharmacy':          "Pharmacy",
        'convenience_store': "Convenience Store",
        'park':              "Eastside Park"
    };

    /* Passages that are fully implemented */
    var OPEN = { 
        'apartment_map': true,
        'kira_apartment': true,
        'marc_apartment': true,
        'coffee_shop': true,
        'regenaform': true
    };

    var svg     = document.querySelector('.city-map');
    var tooltip = document.getElementById('map-tooltip');
    var flash   = document.getElementById('map-blocked-flash');
    if (!svg || !tooltip) return;

    var hideTimer  = null;
    var flashTimer = null;

    function showFlash() {
        if (!flash) return;
        clearTimeout(flashTimer);
        flash.classList.add('visible');
        flashTimer = setTimeout(function () { flash.classList.remove('visible'); }, 1800);
    }

    /* First pass: tag every .ml group with data-loc, then block if needed */
    svg.querySelectorAll('.ml').forEach(function (g) {
        var match = (g.getAttribute('onclick') || '').match(/play\('([^']+)'\)/);
        if (!match) return;
        var passage = match[1];
        g.setAttribute('data-loc', passage);
        if (!OPEN[passage]) {
            g.removeAttribute('onclick');
            g.classList.add('ml-blocked');
        }
    });

    /* Mark blocked mobile legend items */
    document.querySelectorAll('.mml-item').forEach(function (el) {
        var match = (el.getAttribute('onclick') || '').match(/play\('([^']+)'\)/);
        if (match && !OPEN[match[1]]) {
            el.removeAttribute('onclick');
            el.classList.add('mml-blocked');
            el.addEventListener('click', showFlash);
        }
    });

    /* Hover tooltip - reads data-loc set above */
    svg.addEventListener('mouseover', function (e) {
        var g = e.target.closest('.ml');
        if (!g) return;
        var passage = g.getAttribute('data-loc');
        if (!passage) return;
        clearTimeout(hideTimer);
        var label = LABELS[passage] || passage.replace(/_/g, ' ');
        if (!OPEN[passage]) label = '🔒 ' + label;
        tooltip.textContent = '▶ ' + label;
        tooltip.classList.add('visible');
    });

    svg.addEventListener('mouseout', function (e) {
        if (e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest('.ml')) return;
        hideTimer = setTimeout(function () { tooltip.classList.remove('visible'); }, 150);
    });

    /* Click on blocked SVG building → flash */
    svg.addEventListener('click', function (e) {
        if (e.target.closest('.ml-blocked')) showFlash();
    });

}, 0);
<</script>>

<div class="map-mobile-legend">
  <div class="mml-title">◉ LOCATIONS</div>
  <div class="mml-grid">
    <span class="mml-item" style="--c:#e84393" onclick="SugarCube.Engine.play('apartment_map')">★ Eli's Apartment</span>
    <span class="mml-item" style="--c:#a855f7" onclick="SugarCube.Engine.play('kira_apartment')">★ Kira's Apartment</span>
    <span class="mml-item" style="--c:#60a5fa" onclick="SugarCube.Engine.play('marc_apartment')">★ Marc's Apartment</span>
    <span class="mml-item" style="--c:#d97706" onclick="SugarCube.Engine.play('mall')">★ East Side Mall</span>
    <span class="mml-item" style="--c:#2dd4bf" onclick="SugarCube.Engine.play('regenaform')">✦ RegenaForm Clinic</span>
    <span class="mml-item" style="--c:#a0522d" onclick="SugarCube.Engine.play('coffee_shop')">☕ Coffee Shop</span>
    <span class="mml-item" style="--c:#c2791e" onclick="SugarCube.Engine.play('restaurant')">🍴 Restaurant</span>
    <span class="mml-item" style="--c:#9333ea" onclick="SugarCube.Engine.play('salon')">✂ Salon</span>
    <span class="mml-item" style="--c:#22a022" onclick="SugarCube.Engine.play('gym')">◈ Gym</span>
    <span class="mml-item" style="--c:#6060c0" onclick="SugarCube.Engine.play('laundromat')">⌀ Laundromat</span>
    <span class="mml-item" style="--c:#2a9a6a" onclick="SugarCube.Engine.play('pharmacy')">✚ Pharmacy</span>
    <span class="mml-item" style="--c:#3a8a8a" onclick="SugarCube.Engine.play('convenience_store')">◻ Convenience Store</span>
    <span class="mml-item" style="--c:#8a8a20" onclick="SugarCube.Engine.play('liquor_store')">◈ Liquor Store</span>
    <span class="mml-item" style="--c:#9f1239" onclick="SugarCube.Engine.play('sex_toy_shop')">♦ Adult Store</span>
    <span class="mml-item" style="--c:#6a6050" onclick="SugarCube.Engine.play('pawn_shop')">$ Pawn Shop</span>
    <span class="mml-item" style="--c:#4a4a5a" onclick="SugarCube.Engine.play('dark_alley')">▲ Dark Alley</span>
    <span class="mml-item" style="--c:#2a6a2a" onclick="SugarCube.Engine.play('park')">🌳 Eastside Park</span>
  </div>
</div>
<</nobr>>





