:: neighbourhood
<<nobr>>
<<set $right_sidebar_mode to 0>>
<<set $locationName to "East Side District">>
<<set $locationImage to "images/locations/neighbourhood.jpeg">>
<style>
.map-outer {
  max-width: 100%;
  overflow-x: auto;
  background: #0b0b14;
  border: 1.5px solid #e84393;
  border-radius: 12px;
  padding: 8px;
  box-sizing: border-box;
  position: relative;
}
#map-tooltip {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 15, 0.94);
  color: #fd79a8;
  font-family: monospace;
  font-size: 0.72rem;
  font-weight: bold;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 999px;
  border: 1px solid rgba(232, 67, 147, 0.35);
  box-shadow: 0 0 14px rgba(232, 67, 147, 0.2);
  pointer-events: none;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.15s ease;
  z-index: 10;
}
#map-tooltip.visible { opacity: 1; }

/* Blocked SVG buildings */
.ml-blocked { cursor: not-allowed !important; }
.ml-blocked .mb {
  filter: brightness(0.25) saturate(0.1) !important;
  opacity: 0.5;
}
.ml-blocked:hover .mb {
  filter: brightness(0.3) saturate(0.15) !important;
  opacity: 0.55;
}

/* Access blocked flash */
#map-blocked-flash {
  position: fixed;
  top: 50%;
  left: 50%;
  max-width: min(300px, 88vw);
  box-sizing: border-box;
  transform: translate(-50%, -50%) scale(0.9);
  background: rgba(10, 10, 15, 0.96);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #fca5a5;
  font-family: monospace;
  font-size: 0.78rem;
  font-weight: bold;
  letter-spacing: 0.08em;
  text-align: center;
  word-break: break-word;
  padding: 12px 20px;
  border-radius: 10px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 9999;
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
}
#map-blocked-flash.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

/* Mobile location list - hidden on desktop */
.map-mobile-legend { display: none; }

@media (max-width: 900px) {
  .map-mobile-legend {
    display: block;
    margin-top: 10px;
  }
  .mml-title {
    font-family: monospace;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: #4a4a6a;
    text-align: center;
    margin-bottom: 8px;
  }
  .mml-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .mml-item {
    display: block;
    padding: 7px 8px;
    border-radius: 7px;
    border: 1px solid var(--c);
    color: var(--c);
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.03em;
    cursor: pointer;
    text-align: center;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
    opacity: 0.75;
  }
  .mml-item:active { opacity: 1; }
  .mml-blocked {
    --c: #3a3a4a !important;
    cursor: not-allowed !important;
    opacity: 0.3;
  }
}
.city-map {
  width: 100%;
  height: auto;
  display: block;
}
.ml {
  cursor: pointer;
}
.ml .mb {
  transition: opacity 0.15s;
}
.ml:hover .mb {
  opacity: 0.75;
}
.ml-hi:hover .mb {
  filter: brightness(1.2);
}
.map-header {
  font-family: monospace;
  text-align: center;
  color: #a0305a;
  letter-spacing: 0.18em;
  font-size: 0.85em;
  padding: 6px 0 10px 0;
  text-transform: uppercase;
}
</style>

<div class="map-outer">
  <div class="map-header">◉ EAST SIDE DISTRICT - INTERACTIVE MAP</div>
  <svg class="city-map" viewBox="0 0 800 580" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Pink glow filter -->
      <filter id="gp" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#e84393" flood-opacity="0.55" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Blue glow filter -->
      <filter id="gb" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#60a5fa" flood-opacity="0.55" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Amber glow filter -->
      <filter id="ga" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#f59e0b" flood-opacity="0.55" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Teal glow filter -->
      <filter id="gt" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#2dd4bf" flood-opacity="0.55" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <!-- Tree pattern for park -->
      <pattern id="trees" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
        <rect width="28" height="28" fill="#0d1f0d"/>
        <circle cx="8" cy="8" r="5" fill="#1a3a1a"/>
        <circle cx="20" cy="20" r="5" fill="#1a3a1a"/>
        <circle cx="20" cy="8" r="3.5" fill="#1e421e"/>
        <circle cx="8" cy="20" r="3.5" fill="#1e421e"/>
      </pattern>
    </defs>

    <!-- ============================================================ -->
    <!-- BACKGROUND -->
    <!-- ============================================================ -->
    <rect x="0" y="0" width="800" height="580" fill="#0b0b14"/>

    <!-- ============================================================ -->
    <!-- RIVER (bottom) -->
    <!-- ============================================================ -->
    <rect x="0" y="476" width="800" height="104" fill="#09131e"/>
    <!-- River shimmer lines -->
    <line x1="20" y1="494" x2="200" y2="494" stroke="#0d2030" stroke-width="2"/>
    <line x1="60" y1="510" x2="280" y2="510" stroke="#0d2030" stroke-width="2"/>
    <line x1="30" y1="526" x2="190" y2="526" stroke="#0d2030" stroke-width="2"/>
    <line x1="300" y1="500" x2="500" y2="500" stroke="#0d2030" stroke-width="2"/>
    <line x1="350" y1="518" x2="560" y2="518" stroke="#0d2030" stroke-width="2"/>
    <line x1="600" y1="492" x2="780" y2="492" stroke="#0d2030" stroke-width="2"/>
    <line x1="620" y1="512" x2="790" y2="512" stroke="#0d2030" stroke-width="2"/>
    <line x1="580" y1="530" x2="760" y2="530" stroke="#0d2030" stroke-width="2"/>
    <!-- River label -->
    <text x="400" y="540" font-family="monospace" font-size="13" fill="#1e4a6a" text-anchor="middle" letter-spacing="3" font-weight="bold">CLEARWATER RIVER</text>

    <!-- ============================================================ -->
    <!-- ROAD GRID -->
    <!-- H roads: y=108 h=14 (row 1/2 border), y=228 (row 2/3), y=348 (row 3/4), y=460 (row 4/river) -->
    <!-- V roads: x=138 w=14, x=268, x=398, x=518, x=638 -->
    <!-- ============================================================ -->

    <!-- Horizontal roads -->
    <rect x="0" y="108" width="800" height="14" fill="#1a1a2e"/>
    <line x1="0" y1="115" x2="800" y2="115" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="0" y="228" width="800" height="14" fill="#1a1a2e"/>
    <line x1="0" y1="235" x2="800" y2="235" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="0" y="348" width="800" height="14" fill="#1a1a2e"/>
    <line x1="0" y1="355" x2="800" y2="355" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="0" y="460" width="800" height="14" fill="#1a1a2e"/>
    <line x1="0" y1="467" x2="800" y2="467" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>

    <!-- Vertical roads -->
    <rect x="138" y="0" width="14" height="476" fill="#1a1a2e"/>
    <line x1="145" y1="0" x2="145" y2="476" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="268" y="0" width="14" height="476" fill="#1a1a2e"/>
    <line x1="275" y1="0" x2="275" y2="476" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="398" y="0" width="14" height="476" fill="#1a1a2e"/>
    <line x1="405" y1="0" x2="405" y2="476" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="518" y="0" width="14" height="476" fill="#1a1a2e"/>
    <line x1="525" y1="0" x2="525" y2="476" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>
    <rect x="638" y="0" width="14" height="476" fill="#1a1a2e"/>
    <line x1="645" y1="0" x2="645" y2="476" stroke="#2a2a4a" stroke-width="1.5" stroke-dasharray="18,10"/>

    <!-- Street name labels on roads -->
    <!-- Horizontal road labels -->
    <text x="4" y="120" font-family="monospace" font-size="7" fill="#3a3a60" letter-spacing="1">MAPLE AVE</text>
    <text x="4" y="240" font-family="monospace" font-size="7" fill="#3a3a60" letter-spacing="1">CEDAR ST</text>
    <text x="4" y="360" font-family="monospace" font-size="7" fill="#3a3a60" letter-spacing="1">ELM BLVD</text>
    <text x="4" y="472" font-family="monospace" font-size="7" fill="#3a3a60" letter-spacing="1">RIVER RD</text>
    <!-- Vertical road labels (rotated) -->
    <text x="145" y="60" font-family="monospace" font-size="7" fill="#3a3a60" text-anchor="middle" transform="rotate(-90 145 60)">1ST ST</text>
    <text x="275" y="60" font-family="monospace" font-size="7" fill="#3a3a60" text-anchor="middle" transform="rotate(-90 275 60)">2ND ST</text>
    <text x="405" y="60" font-family="monospace" font-size="7" fill="#3a3a60" text-anchor="middle" transform="rotate(-90 405 60)">MAIN ST</text>
    <text x="525" y="60" font-family="monospace" font-size="7" fill="#3a3a60" text-anchor="middle" transform="rotate(-90 525 60)">4TH AVE</text>
    <text x="645" y="60" font-family="monospace" font-size="7" fill="#3a3a60" text-anchor="middle" transform="rotate(-90 645 60)">PARK DR</text>

    <!-- ============================================================ -->
    <!-- BRIDGES OVER RIVER -->
    <!-- ============================================================ -->
    <!-- Bridge at 2nd St (x=268-282) -->
    <rect x="264" y="460" width="22" height="120" fill="#1e1e30"/>
    <line x1="264" y1="464" x2="264" y2="576" stroke="#2a2a4a" stroke-width="2"/>
    <line x1="286" y1="464" x2="286" y2="576" stroke="#2a2a4a" stroke-width="2"/>
    <line x1="264" y1="480" x2="286" y2="480" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="264" y1="496" x2="286" y2="496" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="264" y1="512" x2="286" y2="512" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="264" y1="528" x2="286" y2="528" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="264" y1="544" x2="286" y2="544" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="264" y1="560" x2="286" y2="560" stroke="#2a2a4a" stroke-width="1"/>
    <!-- Bridge at Main St (x=398-412) -->
    <rect x="394" y="460" width="22" height="120" fill="#1e1e30"/>
    <line x1="394" y1="464" x2="394" y2="576" stroke="#2a2a4a" stroke-width="2"/>
    <line x1="416" y1="464" x2="416" y2="576" stroke="#2a2a4a" stroke-width="2"/>
    <line x1="394" y1="480" x2="416" y2="480" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="394" y1="496" x2="416" y2="496" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="394" y1="512" x2="416" y2="512" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="394" y1="528" x2="416" y2="528" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="394" y1="544" x2="416" y2="544" stroke="#2a2a4a" stroke-width="1"/>
    <line x1="394" y1="560" x2="416" y2="560" stroke="#2a2a4a" stroke-width="1"/>

    <!-- ============================================================ -->
    <!-- PARK - Col F (x=652-792, rows 2-4, y=122-474) -->
    <!-- ============================================================ -->
    <rect x="652" y="8" width="140" height="100" fill="url(#trees)" stroke="#1e3a1e" stroke-width="1"/>
    <rect x="652" y="122" width="140" height="106" fill="url(#trees)" stroke="#1e3a1e" stroke-width="1"/>
