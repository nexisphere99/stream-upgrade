


:: regenaform
<<set $locationName to "Regenaform Clinic">>
<<set $right_sidebar_mode to 0>>
<<set $locationImage to "images/locations/regenaform_street_entrance.jpeg">>
<img src="images/locations/regenaform_street_entrance.jpeg" alt="Regenaform Clinic" style="width:100%; height:auto;">
<<if $day == 3 and $day_step == 14>>
<<goto "day_3_15_kira">>
<<elseif $day == 3 and $day_step == 2>>
<<goto "day_3_3_other">>
<<else>>
<<goto "regenaform_map">>
<</if>>
