      <circle cx="530" cy="260" r="2.5" fill="#2dd4bf" opacity="0.5"/>
      <circle cx="564" cy="260" r="2.5" fill="#2dd4bf" opacity="0.5"/>
      <circle cx="598" cy="260" r="2.5" fill="#2dd4bf" opacity="0.5"/>
