    <!-- Wig Fitting Suite -->
    <g class="rml" data-loc="wig_fitting_suite" onclick="SugarCube.Engine.play('wig_fitting_suite')">
      <rect class="rmb" x="6" y="276" width="170" height="120" fill="#0d0b14"/>
