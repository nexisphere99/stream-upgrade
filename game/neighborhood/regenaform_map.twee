      <line x1="20" y1="106" x2="640" y2="106" stroke="#1a1a28" stroke-width="1" stroke-dasharray="8,6"/>
      <text x="330" y="110" font-family="monospace" font-size="6.5" fill="#2a2a3a" text-anchor="middle" letter-spacing="3">STAFF CORRIDOR — BIOMETRIC ACCESS REQUIRED</text>
    </g>

    <!-- ============================================================ -->
    <!-- ROW 3: PROCEDURE ROOMS (y:122-244) -->
