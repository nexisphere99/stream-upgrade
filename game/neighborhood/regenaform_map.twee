    <!-- Suite 4 — Tier 7-8 -->
    <g class="rml" data-loc="procedure_tier7_8">
      <rect class="rmb" x="6" y="122" width="158" height="122" fill="#0a0e10"/>
      <ellipse cx="85" cy="178" rx="44" ry="28" fill="none" stroke="#1a2828" stroke-width="1.5"/>
      <text x="85" y="142" font-family="monospace" font-size="6.5" fill="#1a2828" text-anchor="middle" letter-spacing="1">SUITE 4</text>
      <text x="85" y="154" font-family="monospace" font-size="7.5" fill="#1a2828" text-anchor="middle" font-weight="bold">Tier 7 – 8</text>
      <text x="85" y="216" font-family="monospace" font-size="6" fill="#1a2020" text-anchor="middle">🔒 LOCKED</text>
      <text x="85" y="228" font-family="monospace" font-size="5.5" fill="#141c1c" text-anchor="middle">Neural Integration</text>
    </g>

    <!-- Suite 3 — Tier 4-6 -->
    <g class="rml" data-loc="procedure_tier4_6">
      <rect class="rmb" x="168" y="122" width="154" height="122" fill="#0a0e10"/>
      <rect x="198" y="162" width="94" height="32" rx="6" fill="none" stroke="#1a2828" stroke-width="1.5"/>
      <text x="245" y="142" font-family="monospace" font-size="6.5" fill="#1a2828" text-anchor="middle" letter-spacing="1">SUITE 3</text>
      <text x="245" y="154" font-family="monospace" font-size="7.5" fill="#1a2828" text-anchor="middle" font-weight="bold">Tier 4 – 6</text>
      <text x="245" y="216" font-family="monospace" font-size="6" fill="#1a2020" text-anchor="middle">🔒 LOCKED</text>
      <text x="245" y="228" font-family="monospace" font-size="5.5" fill="#141c1c" text-anchor="middle">Body Contour</text>
    </g>

    <!-- Suite 2 — Tier 2-3 -->
    <g class="rml" data-loc="procedure_tier2_3">
      <rect class="rmb" x="326" y="122" width="154" height="122" fill="#0a0e10"/>
      <rect x="358" y="162" width="88" height="30" rx="5" fill="none" stroke="#1a2828" stroke-width="1.5"/>
      <text x="403" y="142" font-family="monospace" font-size="6.5" fill="#1a2828" text-anchor="middle" letter-spacing="1">SUITE 2</text>
      <text x="403" y="154" font-family="monospace" font-size="7.5" fill="#1a2828" text-anchor="middle" font-weight="bold">Tier 2 – 3</text>
      <text x="403" y="216" font-family="monospace" font-size="6" fill="#1a2020" text-anchor="middle">🔒 LOCKED</text>
      <text x="403" y="228" font-family="monospace" font-size="5.5" fill="#141c1c" text-anchor="middle">Voice / Hair</text>
    </g>

    <!-- Suite 1 — Tier 1 (OPEN, teal glow) -->
    <g class="rml" data-loc="procedure_tier1" onclick="SugarCube.Engine.play('procedure_tier1')" filter="url(#rfg-teal)">
      <rect class="rmb" x="484" y="122" width="170" height="122" fill="#091412"/>
      <!-- Reclining chair -->
      <rect x="512" y="160" width="112" height="34" rx="6" fill="none" stroke="#1a3a36" stroke-width="1.5"/>
      <rect x="512" y="160" width="28" height="34" rx="4" fill="#0c1e1c"/>
      <!-- Medical cross -->
      <line x1="578" y1="148" x2="578" y2="140" stroke="#2dd4bf" stroke-width="1.5" opacity="0.5"/>
      <line x1="574" y1="144" x2="582" y2="144" stroke="#2dd4bf" stroke-width="1.5" opacity="0.5"/>
      <!-- Status LED green -->
      <circle cx="644" cy="130" r="3" fill="#2dd4bf" opacity="0.8"/>
      <text x="569" y="142" font-family="monospace" font-size="6.5" fill="#1a3a36" text-anchor="middle" letter-spacing="1">SUITE 1</text>
      <text x="569" y="210" font-family="monospace" font-size="7.5" fill="#1a3a36" text-anchor="middle" font-weight="bold">Tier 1</text>
      <text x="569" y="222" font-family="monospace" font-size="5.5" fill="#1a2a28" text-anchor="middle">Facial / Cosmetic</text>
    </g>

    <!-- ============================================================ -->
