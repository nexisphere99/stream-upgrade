      <text x="330" y="519" font-family="monospace" font-size="7.5" fill="#1a1424" text-anchor="middle" letter-spacing="1.5">APPROACH HALLWAY</text>
    </g>

    <!-- ============================================================ -->
    <!-- STREET ENTRANCE (y:536-562) -->
    <!-- ============================================================ -->

    <g class="rml" data-loc="street_entrance" onclick="SugarCube.Engine.play('street_entrance')">
      <rect class="rmb" x="248" y="536" width="164" height="26" fill="#08080c"/>
      <!-- Steps -->
      <line x1="248" y1="542" x2="412" y2="542" stroke="#1a1424" stroke-width="1"/>
      <line x1="256" y1="548" x2="404" y2="548" stroke="#1a1424" stroke-width="1"/>
      <line x1="264" y1="554" x2="396" y2="554" stroke="#1a1424" stroke-width="1"/>
      <!-- Brass address plate -->
      <rect x="314" y="538" width="32" height="8" rx="1" fill="#1e180a" stroke="#2a2208" stroke-width="0.5"/>
      <text x="330" y="535" font-family="monospace" font-size="6.5" fill="#1a1424" text-anchor="middle" letter-spacing="1">STREET ENTRANCE</text>
    </g>

    <!-- ============================================================ -->
    <!-- SECTION LABELS -->
    <!-- ============================================================ -->
    <text x="8" y="98" font-family="monospace" font-size="5.5" fill="#2a1a1a" letter-spacing="2">▲ RESTRICTED — AUTHORIZED STAFF ONLY</text>
    <text x="8" y="130" font-family="monospace" font-size="5.5" fill="#1a2a2a" letter-spacing="1.5">PROCEDURE WING</text>

    <!-- Scale bar -->
    <line x1="14" y1="556" x2="64" y2="556" stroke="#1e1e2e" stroke-width="1"/>
    <line x1="14" y1="553" x2="14" y2="559" stroke="#1e1e2e" stroke-width="1"/>
    <line x1="64" y1="553" x2="64" y2="559" stroke="#1e1e2e" stroke-width="1"/>
    <text x="39" y="564" font-family="monospace" font-size="5" fill="#1e1e2e" text-anchor="middle">≈ 5m</text>
    <text x="640" y="556" font-family="monospace" font-size="5" fill="#1e1e2e" text-anchor="middle">▲ N</text>

  </svg>
  <div id="rfm-tooltip"></div>
</div>
<div id="rfm-blocked-flash">⚠ ACCESS RESTRICTED</div>
<br>
[[← District Map|neighbourhood]]
<</nobr>>
<<script>>
(function() {
  var LABELS = {
    'street_entrance':   'Street Entrance',
    'approach_hallway':  'Approach Hallway',
    'reception_lobby':   'Reception Lobby',
    'the_meridian':      'The Meridian',
    'consultation_room': 'Consultation Room',
    'wig_fitting_suite': 'Wig Fitting Suite',
    'client_corridor':   'Client Corridor',
    'procedure_tier1':   'Suite 1 — Tier 1',
    'procedure_tier2_3': 'Suite 2 — Tier 2–3',
    'procedure_tier4_6': 'Suite 3 — Tier 4–6',
    'procedure_tier7_8': 'Suite 4 — Tier 7–8',
    'staff_corridor':    'Staff Corridor',
    'biocompound_lab':   'Biocompound Laboratory',
    'sample_processing': 'Sample Processing',
    'genetic_archive':   'Genetic Archive'
  };
  var OPEN = {
    'street_entrance':   true,
    'approach_hallway':  true,
    'reception_lobby':   true,
    'the_meridian':      true,
    'consultation_room': true,
    'wig_fitting_suite': true,
    'client_corridor':   true,
    'procedure_tier1':   true
  };

  var svg      = document.getElementById('rfm-svg');
  var tooltip  = document.getElementById('rfm-tooltip');
  var flash    = document.getElementById('rfm-blocked-flash');
  var flashTimer = null;
  var hideTimer;
  if (!svg) return;

  function showFlash() {
    if (!flash) return;
    flash.classList.add('visible');
    if (flashTimer) clearTimeout(flashTimer);
    flashTimer = setTimeout(function() { flash.classList.remove('visible'); }, 1800);
  }

  /* Mobile legend */
  document.querySelectorAll('.rfml-item').forEach(function(el) {
    var match = (el.getAttribute('onclick') || '').match(/play\('([^']+)'\)/);
    if (match && !OPEN[match[1]]) {
      el.removeAttribute('onclick');
      el.classList.add('rfml-item-blocked');
      el.addEventListener('click', showFlash);
    }
  });

  /* SVG groups */
  svg.querySelectorAll('.rml').forEach(function(g) {
    var loc = g.getAttribute('data-loc');
    if (!loc || OPEN[loc]) return;
    g.classList.add('rml-blocked');
    g.removeAttribute('onclick');
    g.addEventListener('click', function(e) {
      e.stopPropagation();
      showFlash();
    });
  });

  /* Tooltip */
  svg.addEventListener('mouseover', function(e) {
    var g = e.target.closest('.rml');
    if (!g) return;
    var loc = g.getAttribute('data-loc');
    if (!loc || !LABELS[loc]) return;
    clearTimeout(hideTimer);
    var label = LABELS[loc];
    if (!OPEN[loc]) label = label + ' [RESTRICTED]';
    tooltip.textContent = '▶ ' + label;
    tooltip.classList.add('visible');
  });

  svg.addEventListener('mouseout', function(e) {
    var g = e.target.closest('.rml');
    if (!g) return;
    clearTimeout(hideTimer);
    hideTimer = setTimeout(function() { tooltip.classList.remove('visible'); }, 150);
  });
})();
<</script>>

<div class="rfm-mobile-legend">
  <div class="rfml-title">◉ REGENAFORM — ROOMS</div>
  <div class="rfml-grid">
    <span class="rfml-item" style="--c:#e84393" onclick="SugarCube.Engine.play('street_entrance')">🚪 Street Entrance</span>
    <span class="rfml-item" style="--c:#9893a6" onclick="SugarCube.Engine.play('approach_hallway')">→ Approach Hallway</span>
    <span class="rfml-item" style="--c:#a855f7" onclick="SugarCube.Engine.play('reception_lobby')">✦ Reception Lobby</span>
    <span class="rfml-item" style="--c:#f59e0b" onclick="SugarCube.Engine.play('the_meridian')">◎ The Meridian</span>
    <span class="rfml-item" style="--c:#2dd4bf" onclick="SugarCube.Engine.play('consultation_room')">◈ Consultation Room</span>
    <span class="rfml-item" style="--c:#a855f7" onclick="SugarCube.Engine.play('wig_fitting_suite')">✂ Wig Fitting Suite</span>
    <span class="rfml-item" style="--c:#2dd4bf" onclick="SugarCube.Engine.play('client_corridor')">→ Client Corridor</span>
    <span class="rfml-item" style="--c:#2dd4bf" onclick="SugarCube.Engine.play('procedure_tier1')">✚ Suite 1 — Tier 1</span>
    <span class="rfml-item" style="--c:#3a3a4a" onclick="SugarCube.Engine.play('procedure_tier2_3')">🔒 Suite 2 — Tier 2–3</span>
    <span class="rfml-item" style="--c:#3a3a4a" onclick="SugarCube.Engine.play('procedure_tier4_6')">🔒 Suite 3 — Tier 4–6</span>
    <span class="rfml-item" style="--c:#3a3a4a" onclick="SugarCube.Engine.play('procedure_tier7_8')">🔒 Suite 4 — Tier 7–8</span>
    <span class="rfml-item" style="--c:#3a3a4a" onclick="SugarCube.Engine.play('staff_corridor')">🔒 Staff Corridor</span>
  </div>
</div>


