:: regenaform_map
<<nobr>>
<style>
.rfm-outer {
  max-width: 100%;
  overflow-x: auto;
  background: #08080f;
  border: 1.5px solid #2dd4bf;
  border-radius: 12px;
  padding: 8px;
  box-sizing: border-box;
  position: relative;
}
.rfm-header {
  font-family: monospace;
  text-align: center;
  color: #1a5050;
  letter-spacing: 0.18em;
  font-size: 0.85em;
  padding: 6px 0 10px;
  text-transform: uppercase;
}
.rfm-map { width: 100%; height: auto; display: block; }
.rml { cursor: pointer; }
.rml .rmb {
  transition: opacity 0.15s, stroke 0.15s, stroke-width 0.15s;
  stroke: transparent;
  stroke-width: 0;
}
.rml:hover .rmb {
  stroke: rgba(45, 212, 191, 0.55);
  stroke-width: 2.5;
  opacity: 0.88;
}
.rml-blocked { cursor: not-allowed !important; }
.rml-blocked .rmb {
  filter: brightness(0.25) saturate(0.1) !important;
  opacity: 0.5;
}
.rml-blocked:hover .rmb {
  filter: brightness(0.3) saturate(0.15) !important;
  opacity: 0.55;
}
#rfm-tooltip {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 15, 0.94);
  color: #2dd4bf;
  font-family: monospace;
  font-size: 0.72rem;
  font-weight: bold;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 999px;
  border: 1px solid rgba(45, 212, 191, 0.35);
  box-shadow: 0 0 14px rgba(45, 212, 191, 0.2);
  pointer-events: none;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.15s ease;
  z-index: 9000;
}
#rfm-tooltip.visible { opacity: 1; }
#rfm-blocked-flash {
  position: fixed;
  top: 50%;
  left: 50%;
  max-width: min(300px, 88vw);
  box-sizing: border-box;
  transform: translate(-50%, -50%) scale(0.9);
  background: rgba(10, 10, 15, 0.96);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #fca5a5;
  font-family: monospace;
  font-size: 0.78rem;
  font-weight: bold;
  letter-spacing: 0.08em;
  text-align: center;
  word-break: break-word;
  padding: 12px 20px;
  border-radius: 10px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 9999;
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
}
#rfm-blocked-flash.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}
.rfm-mobile-legend { display: none; }
@media (max-width: 900px) {
  .rfm-mobile-legend { display: block; margin-top: 10px; }
  .rfml-title {
    font-family: monospace;
    font-size: 0.68rem;
    color: #5d5875;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .rfml-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .rfml-item {
    display: block;
    padding: 7px 8px;
    border-radius: 7px;
    border: 1px solid var(--c);
    color: var(--c);
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: bold;
    letter-spacing: 0.03em;
    cursor: pointer;
    text-align: center;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
    opacity: 0.75;
  }
  .rfml-item:active { opacity: 1; }
  .rfml-item-blocked {
    --c: #3a3a4a !important;
    cursor: not-allowed !important;
    opacity: 0.3;
  }
}
</style>

<div class="rfm-outer" id="rfm-container">
  <div class="rfm-header">◉ REGENAFORM CLINIC — FLOOR PLAN</div>
  <svg class="rfm-map" viewBox="0 0 660 568" xmlns="http://www.w3.org/2000/svg" id="rfm-svg">
    <defs>
      <filter id="rfg-teal" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#2dd4bf" flood-opacity="0.4" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <filter id="rfg-amber" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#f59e0b" flood-opacity="0.35" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="5" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <filter id="rfg-pink" x="-30%" y="-30%" width="160%" height="160%">
        <feFlood flood-color="#e84393" flood-opacity="0.3" result="color"/>
        <feComposite in="color" in2="SourceGraphic" operator="in" result="shadow"/>
        <feGaussianBlur in="shadow" stdDeviation="4" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- Background -->
    <rect x="0" y="0" width="660" height="568" fill="#08080f"/>

    <!-- Outer walls -->
    <rect x="0" y="0" width="660" height="6" fill="#1a1a2e"/>
    <rect x="0" y="0" width="6" height="568" fill="#1a1a2e"/>
    <rect x="654" y="0" width="6" height="568" fill="#1a1a2e"/>
    <rect x="0" y="562" width="660" height="6" fill="#1a1a2e"/>

    <!-- Row dividers -->
    <rect x="6" y="90" width="648" height="4" fill="#1a1a2e"/>
    <rect x="6" y="118" width="648" height="4" fill="#1a1a2e"/>
    <rect x="6" y="244" width="648" height="4" fill="#1a1a2e"/>
    <rect x="6" y="272" width="648" height="4" fill="#1a1a2e"/>
    <rect x="6" y="396" width="648" height="4" fill="#1a1a2e"/>
    <!-- Walls flanking hallway/entrance -->
    <rect x="6" y="494" width="172" height="68" fill="#1a1a2e"/>
    <rect x="482" y="494" width="172" height="68" fill="#1a1a2e"/>

    <!-- Vertical dividers — restricted row -->
    <rect x="202" y="6" width="4" height="88" fill="#1a1a2e"/>
    <rect x="452" y="6" width="4" height="88" fill="#1a1a2e"/>

    <!-- Vertical dividers — procedure row -->
    <rect x="164" y="122" width="4" height="126" fill="#1a1a2e"/>
    <rect x="322" y="122" width="4" height="126" fill="#1a1a2e"/>
    <rect x="480" y="122" width="4" height="126" fill="#1a1a2e"/>

    <!-- Vertical dividers — inner rooms row -->
    <rect x="176" y="276" width="4" height="124" fill="#1a1a2e"/>
    <rect x="344" y="276" width="4" height="124" fill="#1a1a2e"/>

    <!-- ============================================================ -->
    <!-- ROW 1: RESTRICTED (y:6-90) -->
    <!-- ============================================================ -->

    <!-- Genetic Archive -->
    <g class="rml" data-loc="genetic_archive">
      <rect class="rmb" x="6" y="6" width="196" height="84" fill="#0e0e18"/>
      <text x="104" y="38" font-family="monospace" font-size="6.5" fill="#2a1a1a" text-anchor="middle" letter-spacing="2">RESTRICTED</text>
      <text x="104" y="54" font-family="monospace" font-size="8" fill="#2a1a1a" text-anchor="middle" font-weight="bold">Genetic Archive</text>
      <text x="104" y="68" font-family="monospace" font-size="6" fill="#1e1212" text-anchor="middle">⛔ STAFF ONLY</text>
    </g>

    <!-- Biocompound Laboratory -->
    <g class="rml" data-loc="biocompound_lab">
      <rect class="rmb" x="206" y="6" width="246" height="84" fill="#0e0e18"/>
      <text x="329" y="38" font-family="monospace" font-size="6.5" fill="#2a1a1a" text-anchor="middle" letter-spacing="2">RESTRICTED</text>
      <text x="329" y="54" font-family="monospace" font-size="8" fill="#2a1a1a" text-anchor="middle" font-weight="bold">Biocompound Laboratory</text>
      <text x="329" y="68" font-family="monospace" font-size="6" fill="#1e1212" text-anchor="middle">⛔ STAFF ONLY</text>
    </g>

    <!-- Sample Processing -->
    <g class="rml" data-loc="sample_processing">
      <rect class="rmb" x="456" y="6" width="198" height="84" fill="#0e0e18"/>
      <text x="555" y="38" font-family="monospace" font-size="6.5" fill="#2a1a1a" text-anchor="middle" letter-spacing="2">RESTRICTED</text>
      <text x="555" y="54" font-family="monospace" font-size="8" fill="#2a1a1a" text-anchor="middle" font-weight="bold">Sample Processing</text>
      <text x="555" y="68" font-family="monospace" font-size="6" fill="#1e1212" text-anchor="middle">⛔ STAFF ONLY</text>
    </g>

    <!-- ============================================================ -->
    <!-- ROW 2: STAFF CORRIDOR (y:94-118) -->
    <!-- ============================================================ -->

    <g class="rml" data-loc="staff_corridor">
