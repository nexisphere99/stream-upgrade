    <!-- APPROACH HALLWAY (y:498-532) -->
    <!-- ============================================================ -->

    <g class="rml" data-loc="approach_hallway" onclick="SugarCube.Engine.play('approach_hallway')">
      <rect class="rmb" x="178" y="498" width="304" height="34" fill="#09090e"/>
      <!-- Frosted door line at top -->
