};

// ── STATE ────────────────────────────────────────────────────────────────────
var state = { tier: null, cat: null, opt: null };

// ── HELPERS ──────────────────────────────────────────────────────────────────
function el(id) { return document.getElementById(id); }

function placeholder(sym, color) {
  return '<div class="mer-opt-img" style="--tc:' + color + ';--tcr:0,0,0">'
    + '<span class="opt-placeholder-icon">' + sym + '</span>'
    + '</div>';
}

// ── RENDER TIER GRID ──────────────────────────────────────────────────────────
function renderTiers() {
  el('mer-cat-panel').classList.add('mer-hidden');
  el('mer-opt-panel').classList.add('mer-hidden');
  el('mer-tier-panel').classList.remove('mer-hidden');
  el('mer-breadcrumb').innerHTML = '';
  state.tier = null; state.cat = null;

  var html = '<div class="mer-tier-grid">';
  D.tiers.forEach(function(t) {
    var lockClass = t.locked ? ' locked' : '';
    var badge = t.locked
      ? '<span class="mer-lock-badge">🔒</span>'
      : '<span class="mer-suite-badge">' + t.suite + '</span>';
    html += '<div class="mer-tier-card' + lockClass + '" data-tid="' + t.id + '" style="--tc:' + t.color + ';--tcr:' + t.cr + '">'
      + badge
      + '<div class="mer-tier-icon">' + t.icon + '</div>'
      + '<div class="mer-tier-num">' + t.label + '</div>'
      + '<div class="mer-tier-name">' + t.name + '</div>'
      + '<div class="mer-tier-meta">'
      + '<div><span class="mc">Cost:</span> ' + t.cost + '</div>'
      + '<div><span class="mc">App:</span> ' + t.score + '</div>'
      + '<div><span class="mc">Recovery:</span> ' + t.recovery + '</div>'
      + '</div></div>';
  });
  html += '</div>';
  el('mer-tier-panel').innerHTML = html;

  document.querySelectorAll('.mer-tier-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var tid = this.getAttribute('data-tid');
      var tier = D.tiers.find(function(t) { return t.id === tid; });
      if (!tier) return;
      if (tier.locked) {
        var f = el('mer-locked-flash');
        if (f) {
          f.classList.add('visible');
          setTimeout(function() { f.classList.remove('visible'); }, 2000);
        }
        return;
      }
      if (tier.cats.length === 0) {
        showTierInfo(tier);
        return;
      }
      state.tier = tier;
      renderCategories(tier);
    });
  });
}

function showTierInfo(tier) {
  var o = el('mer-overlay');
  o.style.setProperty('--tc', tier.color);
  o.style.setProperty('--tcr', tier.cr);
  o.classList.remove('mer-hidden');
  el('mer-detail-img').textContent = tier.icon;
  el('mer-detail-tier-tag').textContent = tier.label + ' - ' + tier.suite;
  el('mer-detail-name').textContent = tier.name;
  el('mer-detail-rows').innerHTML =
    '<div class="mer-detail-row"><span class="mer-detail-label">COST</span><span class="mer-detail-val cost">' + tier.cost + '</span></div>'
    + '<div class="mer-detail-row"><span class="mer-detail-label">APPEARANCE</span><span class="mer-detail-val score">' + tier.score + '</span></div>'
    + '<div class="mer-detail-row"><span class="mer-detail-label">RECOVERY</span><span class="mer-detail-val">' + tier.recovery + '</span></div>';
  el('mer-detail-desc').textContent = tier.desc;
  el('mer-detail-effects').innerHTML = '<em>Select a category to view individual procedures.</em>';
  el('mer-btn-purchase').textContent = 'VIEW PROCEDURES';
  el('mer-btn-purchase').className = 'mer-btn-purchase locked-btn';
}

// ── RENDER CATEGORY GRID ─────────────────────────────────────────────────────
function renderCategories(tier) {
  el('mer-tier-panel').classList.add('mer-hidden');
  el('mer-opt-panel').classList.add('mer-hidden');
  var panel = el('mer-cat-panel');
  panel.classList.remove('mer-hidden');

  el('mer-breadcrumb').innerHTML = '<span style="cursor:pointer" id="mer-bc-home">◉ THE MERIDIAN</span>'
    + ' › <span style="color:#e0dcea">' + tier.label + ' - ' + tier.name + '</span>';
  document.getElementById('mer-bc-home').addEventListener('click', renderTiers);

  var html = '<button class="mer-back-btn" id="mer-cat-back">← Back to Tiers</button>'
    + '<div class="mer-section-header">'
    + '<div class="mer-section-title" style="color:' + tier.color + '">' + tier.label + ' - ' + tier.name + '</div>'
    + '<div class="mer-section-sub">' + tier.desc + '</div>'
    + '</div>'
    + '<div class="mer-cat-grid">';

  tier.cats.forEach(function(cat) {
    html += '<div class="mer-cat-card" data-cid="' + cat.id + '" style="--tc:' + tier.color + ';--tcr:' + tier.cr + '">'
      + '<div class="mer-cat-icon">' + cat.icon + '</div>'
      + '<div class="mer-cat-name">' + cat.name + '</div>'
      + '<div class="mer-cat-count">' + cat.opts.length + ' option' + (cat.opts.length !== 1 ? 's' : '') + '</div>'
      + '</div>';
  });
  html += '</div>';
  panel.innerHTML = html;

  document.getElementById('mer-cat-back').addEventListener('click', renderTiers);
  document.querySelectorAll('.mer-cat-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var cid = this.getAttribute('data-cid');
      var cat = tier.cats.find(function(c) { return c.id === cid; });
      if (!cat) return;
      state.cat = cat;
      renderOptions(tier, cat);
    });
  });
}

// ── RENDER OPTION GRID ───────────────────────────────────────────────────────
function renderOptions(tier, cat) {
  el('mer-cat-panel').classList.add('mer-hidden');
  var panel = el('mer-opt-panel');
  panel.classList.remove('mer-hidden');

  el('mer-breadcrumb').innerHTML = '<span style="cursor:pointer" id="mer-bc-home2">◉ THE MERIDIAN</span>'
    + ' › <span style="cursor:pointer" id="mer-bc-tier2">' + tier.label + ' - ' + tier.name + '</span>'
    + ' › <span style="color:#e0dcea">' + cat.name + '</span>';
  document.getElementById('mer-bc-home2').addEventListener('click', renderTiers);
  document.getElementById('mer-bc-tier2').addEventListener('click', function() { renderCategories(tier); });

  var isCombo = cat.isCombo;

  var html = '<button class="mer-back-btn" id="mer-opt-back">← Back to ' + tier.label + '</button>'
    + '<div class="mer-section-header">'
    + '<div class="mer-section-title" style="color:' + tier.color + '">' + cat.name + '</div>'
    + '<div class="mer-section-sub">' + tier.label + ' · ' + cat.opts.length + ' options available</div>'
    + '</div>';

  if (isCombo) {
    html += '<div>';
    cat.opts.forEach(function(opt) {
      html += '<div class="mer-combo-card">'
        + '<div class="mer-combo-name">★ ' + opt.name + ' <span style="font-size:0.7rem;color:#9893a6;font-weight:normal;font-family:monospace">' + opt.score + '</span></div>'
        + '<div class="mer-combo-desc">' + opt.desc + '<br><em style="color:#2dd4bf">' + opt.effect + '</em></div>'
        + '</div>';
    });
    html += '</div>';
  } else {
    html += '<div class="mer-opt-grid">';
    cat.opts.forEach(function(opt, i) {
      var exclBadge = opt.excl ? '<span class="mer-excl-badge">⚔ EXCL</span>' : '';
      var prereqBadge = opt.prereq ? '<span class="mer-prereq-badge">🔗 PREREQ</span>' : '';
      html += '<div class="mer-opt-card" data-oidx="' + i + '" style="--tc:' + tier.color + ';--tcr:' + tier.cr + '">'
        + placeholder(opt.placeholder, tier.color)
        + '<div class="mer-opt-body">'
        + '<div class="mer-opt-name">' + opt.name + exclBadge + prereqBadge + '</div>'
        + '<div class="mer-opt-cost">' + (opt.cost > 0 ? opt.cost.toLocaleString() + ' $' : 'Included') + '</div>'
        + '<div class="mer-opt-score">App ' + opt.score + '</div>'
        + '</div></div>';
    });
    html += '</div>';
  }

  panel.innerHTML = html;
  document.getElementById('mer-opt-back').addEventListener('click', function() { renderCategories(tier); });

  if (!isCombo) {
    document.querySelectorAll('.mer-opt-card').forEach(function(card) {
      card.addEventListener('click', function() {
        var idx = parseInt(this.getAttribute('data-oidx'));
        showDetail(tier, cat, cat.opts[idx]);
      });
    });
  }
}

// ── DETAIL OVERLAY ───────────────────────────────────────────────────────────
function showDetail(tier, cat, opt) {
  var o = el('mer-overlay');
  o.style.setProperty('--tc', tier.color);
  o.style.setProperty('--tcr', tier.cr);
  o.classList.remove('mer-hidden');
  el('mer-detail-img').textContent = opt.placeholder;
  el('mer-detail-tier-tag').textContent = tier.label + ' - ' + cat.name;
  el('mer-detail-name').textContent = opt.name;
  el('mer-detail-rows').innerHTML =
    '<div class="mer-detail-row"><span class="mer-detail-label">COST</span><span class="mer-detail-val cost">' + (opt.cost > 0 ? opt.cost.toLocaleString() + ' $' : 'Included') + '</span></div>'
    + '<div class="mer-detail-row"><span class="mer-detail-label">APPEARANCE BONUS</span><span class="mer-detail-val score">' + opt.score + '</span></div>'
    + '<div class="mer-detail-row"><span class="mer-detail-label">RECOVERY TIME</span><span class="mer-detail-val">' + opt.recovery + '</span></div>'
    + (opt.excl ? '<div class="mer-detail-row"><span class="mer-detail-label">NOTE</span><span class="mer-detail-val" style="color:#ef4444">⚔ Mutually exclusive - one option per category</span></div>' : '')
    + (opt.prereq ? '<div class="mer-detail-row"><span class="mer-detail-label">PREREQUISITE</span><span class="mer-detail-val" style="color:#a855f7">🔗 Special approval required</span></div>' : '');
  el('mer-detail-desc').textContent = opt.desc;
  el('mer-detail-effects').innerHTML = '<strong style="color:var(--tc);font-size:0.7rem;letter-spacing:0.1em;font-family:monospace">GAMEPLAY EFFECT</strong><br>' + opt.effect;

  var sc = (typeof State !== 'undefined' && State.variables) ? (State.variables.sc || 0) : 0;
  var canAfford = sc >= opt.cost;
  var btn = el('mer-btn-purchase');
  if (opt.cost === 0) {
    btn.textContent = 'COMBO TRACKER';
    btn.className = 'mer-btn-purchase locked-btn';
  } else if (!canAfford) {
    btn.textContent = 'INSUFFICIENT $ (' + sc.toLocaleString() + ' / ' + opt.cost.toLocaleString() + ')';
    btn.className = 'mer-btn-purchase locked-btn';
  } else {
    btn.textContent = 'PURCHASE - ' + opt.cost.toLocaleString() + ' $';
    btn.className = 'mer-btn-purchase';
  }
}

// ── INIT ─────────────────────────────────────────────────────────────────────
// Defer all DOM access until after SugarCube has rendered the passage HTML.
$(document).one(':passagedisplay', function() {

  var scVal = (typeof State !== 'undefined' && State.variables) ? (State.variables.sc || 0) : 0;
  var scDisp = el('mer-sc-display');
  if (scDisp) scDisp.textContent = scVal.toLocaleString() + ' $';

  renderTiers();

  // Close overlay on button
  var closeBtn = document.getElementById('mer-btn-close');
  if (closeBtn) closeBtn.addEventListener('click', function() {
    el('mer-overlay').classList.add('mer-hidden');
  });

  // Close overlay on backdrop click
  var overlay = document.getElementById('mer-overlay');
  if (overlay) overlay.addEventListener('click', function(e) {
    if (e.target === this) el('mer-overlay').classList.add('mer-hidden');
  });

});

})();
<</script>>
