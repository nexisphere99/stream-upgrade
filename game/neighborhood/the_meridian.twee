:: the_meridian
<<nobr>>
<style>
/* ── VARIABLES & BASE ─────────────────────────────────────────────────── */
/* Background: #08080f, surfaces: #0d0d1a, border: rgba(45,212,191,0.2) */

#mer-wrap {
  max-width: 900px;
  margin: 0 auto;
  font-family: var(--font-ui, 'Outfit', sans-serif);
}

/* Header / breadcrumb */
#mer-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 1.5rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid rgba(45, 212, 191, 0.2);
}
#mer-title {
  font-size: 1.4rem;
  font-weight: bold;
  color: #f59e0b;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
#mer-breadcrumb {
  font-family: monospace;
  font-size: 0.75rem;
  color: #5d5875;
  letter-spacing: 0.08em;
}
#mer-breadcrumb span { color: #2dd4bf; }

/* Tier grid - 4 columns desktop, 2 mobile */
.mer-tier-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}
@media (max-width: 700px) { .mer-tier-grid { grid-template-columns: repeat(2, 1fr); } }

/* Category grid - 3 columns */
.mer-cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
@media (max-width: 700px) { .mer-cat-grid { grid-template-columns: repeat(2, 1fr); } }

/* Option grid - 3 columns */
.mer-opt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
@media (max-width: 700px) { .mer-opt-grid { grid-template-columns: repeat(2, 1fr); } }

/* Tier card */
.mer-tier-card {
  background: #0d0d1a;
  border: 1px solid var(--tc);
  border-radius: 10px;
  padding: 16px 12px;
  cursor: pointer;
  transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}
.mer-tier-card:hover {
  background: rgba(var(--tcr),0.07);
  box-shadow: 0 0 20px rgba(var(--tcr),0.2);
  transform: translateY(-2px);
}
.mer-tier-card.locked {
  opacity: 0.45;
  cursor: not-allowed;
  filter: saturate(0.3);
}
.mer-tier-card.locked:hover { transform: none; box-shadow: none; }
.mer-tier-icon {
  font-size: 1.6rem;
  margin-bottom: 6px;
  color: var(--tc);
}
.mer-tier-num {
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--tc);
  opacity: 0.7;
  font-family: monospace;
  margin-bottom: 2px;
  text-transform: uppercase;
}
.mer-tier-name {
  font-size: 0.9rem;
  font-weight: bold;
  color: #e8e4f0;
  margin-bottom: 8px;
}
.mer-tier-meta {
  font-family: monospace;
  font-size: 0.62rem;
  color: #4a4a6a;
  line-height: 1.6;
}
.mer-tier-meta .mc { color: var(--tc); opacity: 0.8; }
.mer-lock-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 0.7rem;
  color: #ef4444;
  opacity: 0.7;
}
.mer-suite-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 0.55rem;
  font-family: monospace;
  letter-spacing: 0.1em;
  color: var(--tc);
  opacity: 0.5;
  text-transform: uppercase;
}

/* Category card */
.mer-cat-card {
  background: #0d0d1a;
  border: 1px solid rgba(255,255,255,0.06);
  border-left: 3px solid var(--tc);
  border-radius: 8px;
  padding: 14px;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
}
.mer-cat-card:hover {
  background: rgba(var(--tcr),0.05);
  transform: translateX(3px);
}
.mer-cat-icon { font-size: 1.3rem; margin-bottom: 6px; }
.mer-cat-name { font-size: 0.88rem; font-weight: bold; color: #e0dcea; margin-bottom: 4px; }
.mer-cat-count { font-family: monospace; font-size: 0.65rem; color: #5d5875; }

/* Option card */
.mer-opt-card {
  background: #0d0d1a;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
}
.mer-opt-card:hover {
  border-color: var(--tc);
  box-shadow: 0 0 16px rgba(var(--tcr),0.2);
  transform: translateY(-2px);
}
.mer-opt-img {
  width: 100%;
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: monospace;
  background: linear-gradient(135deg, rgba(var(--tcr),0.12) 0%, rgba(0,0,0,0.3) 100%);
  border-bottom: 1px solid rgba(var(--tcr),0.15);
  color: var(--tc);
  opacity: 0.7;
  letter-spacing: 0.05em;
  font-size: 0.65rem;
  text-transform: uppercase;
  flex-direction: column;
  gap: 4px;
}
.mer-opt-img .opt-placeholder-icon { font-size: 2rem; opacity: 0.4; }
.mer-opt-body { padding: 10px 12px; }
.mer-opt-name { font-size: 0.82rem; font-weight: bold; color: #e0dcea; margin-bottom: 4px; }
.mer-opt-cost { font-family: monospace; font-size: 0.7rem; color: #f59e0b; }
.mer-opt-score { font-family: monospace; font-size: 0.65rem; color: #2dd4bf; margin-top: 2px; }
.mer-excl-badge {
  font-size: 0.55rem;
  background: rgba(239,68,68,0.15);
  color: #ef4444;
  border-radius: 4px;
  padding: 1px 5px;
  margin-left: 4px;
  font-family: monospace;
}
.mer-prereq-badge {
  font-size: 0.55rem;
  background: rgba(168,85,247,0.15);
  color: #a855f7;
  border-radius: 4px;
  padding: 1px 5px;
  margin-left: 4px;
  font-family: monospace;
}

/* Detail overlay */
#mer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(5, 5, 12, 0.92);
  z-index: 8000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  overflow-y: auto;
}
#mer-overlay.mer-hidden { display: none !important; }
#mer-detail-box {
  background: #0d0d1a;
  border: 1px solid var(--tc);
  border-radius: 14px;
  max-width: 580px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 0 60px rgba(var(--tcr),0.3);
}
#mer-detail-img {
  width: 100%;
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(var(--tcr),0.15) 0%, #080810 100%);
  border-radius: 14px 14px 0 0;
  font-size: 3.5rem;
  opacity: 0.5;
  border-bottom: 1px solid rgba(var(--tcr),0.2);
}
#mer-detail-body { padding: 20px 24px; }
#mer-detail-tier-tag {
  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--tc);
  opacity: 0.7;
  text-transform: uppercase;
  margin-bottom: 6px;
}
#mer-detail-name {
  font-size: 1.3rem;
  font-weight: bold;
  color: #f0ecff;
  margin-bottom: 14px;
}
.mer-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  font-size: 0.82rem;
}
.mer-detail-label { color: #5d5875; font-family: monospace; font-size: 0.72rem; letter-spacing: 0.05em; }
.mer-detail-val { color: #e0dcea; font-weight: bold; }
.mer-detail-val.cost { color: #f59e0b; }
.mer-detail-val.score { color: #2dd4bf; }
.mer-detail-val.locked-val { color: #ef4444; }
#mer-detail-desc {
  margin-top: 14px;
  font-size: 0.85rem;
  color: #9893a6;
  line-height: 1.7;
}
#mer-detail-effects {
  margin-top: 12px;
  padding: 10px 14px;
  background: rgba(var(--tcr),0.05);
  border-left: 3px solid var(--tc);
  border-radius: 0 6px 6px 0;
  font-size: 0.78rem;
  color: #c8c4d4;
  line-height: 1.6;
}
.mer-detail-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}
.mer-btn-close {
  flex: 1;
  padding: 10px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #9893a6;
  font-family: monospace;
  font-size: 0.8rem;
  cursor: pointer;
  letter-spacing: 0.08em;
}
.mer-btn-close:hover { border-color: rgba(255,255,255,0.2); color: #e0dcea; }
.mer-btn-purchase {
  flex: 2;
  padding: 10px;
  background: var(--tc);
  border: none;
  border-radius: 8px;
  color: #08080f;
  font-family: monospace;
  font-size: 0.82rem;
  font-weight: bold;
  cursor: pointer;
  letter-spacing: 0.08em;
}
.mer-btn-purchase:hover { opacity: 0.85; }
.mer-btn-purchase.locked-btn {
  background: #2a2a3a;
  color: #ef4444;
  cursor: not-allowed;
}

/* Back button */
.mer-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1px solid rgba(45,212,191,0.2);
  border-radius: 6px;
  color: #2dd4bf;
  font-family: monospace;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  padding: 5px 12px;
  cursor: pointer;
  margin-bottom: 16px;
  transition: border-color 0.15s, background 0.15s;
}
.mer-back-btn:hover { border-color: rgba(45,212,191,0.5); background: rgba(45,212,191,0.05); }

/* Panel transitions */
.mer-panel { animation: mer-fade-in 0.2s ease; }
.mer-hidden { display: none !important; }
@keyframes mer-fade-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* Section header */
.mer-section-header {
  margin-bottom: 16px;
}
.mer-section-title {
  font-size: 1.1rem;
  font-weight: bold;
  color: #e0dcea;
  margin-bottom: 4px;
}
.mer-section-sub {
  font-family: monospace;
  font-size: 0.72rem;
  color: #5d5875;
  letter-spacing: 0.06em;
}

/* Combo section */
.mer-combo-card {
  background: rgba(245,158,11,0.05);
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 8px;
}
.mer-combo-name { font-size: 0.85rem; font-weight: bold; color: #f59e0b; margin-bottom: 4px; }
.mer-combo-desc { font-size: 0.75rem; color: #9893a6; line-height: 1.5; }

/* $ balance display */
#mer-sc-display {
  margin-left: auto;
  font-family: monospace;
  font-size: 0.8rem;
  color: #f59e0b;
  background: rgba(245,158,11,0.08);
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 6px;
  padding: 4px 10px;
}

/* Locked flash */
#mer-locked-flash.visible { opacity: 1 !important; transform: translate(-50%,-50%) scale(1) !important; }
</style>

<div id="mer-wrap" style="--tc:#2dd4bf;--tcr:45,212,191">
  <div id="mer-header">
    <div>
      <div id="mer-title">◎ THE MERIDIAN</div>
      <div id="mer-breadcrumb"></div>
    </div>
    <div id="mer-sc-display">0 $</div>
  </div>

  <div id="mer-tier-panel" class="mer-panel"></div>
  <div id="mer-cat-panel" class="mer-panel mer-hidden"></div>
  <div id="mer-opt-panel" class="mer-panel mer-hidden"></div>
</div>

<div id="mer-overlay" class="mer-hidden">
  <div id="mer-detail-box">
    <div id="mer-detail-img"></div>
    <div id="mer-detail-body">
      <div id="mer-detail-tier-tag"></div>
      <div id="mer-detail-name"></div>
      <div id="mer-detail-rows"></div>
      <div id="mer-detail-desc"></div>
      <div id="mer-detail-effects"></div>
      <div class="mer-detail-actions">
        <button class="mer-btn-close" id="mer-btn-close">✕ CLOSE</button>
        <button class="mer-btn-purchase" id="mer-btn-purchase">PURCHASE</button>
      </div>
    </div>
  </div>
</div>

<div id="mer-locked-flash" style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.9);background:rgba(10,10,15,0.96);border:1px solid rgba(239,68,68,0.4);color:#fca5a5;font-family:monospace;font-size:0.8rem;font-weight:bold;text-align:center;padding:14px 22px;border-radius:10px;pointer-events:none;opacity:0;transition:opacity 0.2s ease,transform 0.2s ease;z-index:9999;max-width:min(280px,88vw)">
  🔒 TIER LOCKED - Prerequisites not met
</div>
<br>
